# Базовый образ для Go
FROM golang:1.22-alpine

# Установка рабочей директорию внутри контейнера
WORKDIR /app

# Копирование данных
COPY go.mod ./
COPY go.sum ./

# Загрузка зависимостей
RUN go mod download

# Копирование остальных данных
COPY . .

# Сборка
RUN go build -o main .

# Команда для запуска приложения
CMD ["./main"]

# Открытие порта, используемого приложением
EXPOSE 8090
